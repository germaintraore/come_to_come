# ============================================================
# Come To Code - Variables d'environnement
# ============================================================
# Copiez ce fichier en ".env" et renseignez vos vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être partagé publiquement.

# Django
DJANGO_SECRET_KEY=change-moi-en-production-cle-secrete-aleatoire
DJANGO_DEBUG=True

# Base de données PostgreSQL
DB_NAME=come_to_code_db
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_postgres
DB_HOST=localhost
DB_PORT=5432
# Ou directement une DATABASE_URL (ex: Neon.tech) :
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ============================================================
# Stockage des Fichiers Médias (Persistance après mise à jour serveur)
# Sur Render, le disque local est éphémère.
# Option 1 (Recommandée & Gratuite) : Cloudinary
# Créez un compte gratuit sur https://cloudinary.com et copiez votre CLOUDINARY_URL :
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Option 2 : Disque persistant Render Disk (ou chemin serveur spécifique)
# MEDIA_ROOT_PATH=/var/data/media
# ============================================================

